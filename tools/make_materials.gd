extends SceneTree

# Builds Genesis's material presets: textures drawn here from noise and
# simple patterns, so every one is ours to license (CC0). Run headless:
#
#     godot --headless --path . -s tools/make_materials.gd
#
# Every preset maps its texture triplanar in WORLD space, so a brick is a
# brick-sized brick on any model, whatever state its UVs are in. Imported
# architecture rarely has usable UVs; this is why.

const OUT := "res://genesis_data/materials"
const SIZE := 512


# Scanned CC0 materials fetched by tools/fetch_assets.py, when present, with
# the real-world width each texture covers (height follows its aspect).
const SCANNED := "res://genesis_data/external/materials"
const SCAN_WIDTH_M := {
	"brick": 2.4, "concrete": 3.0, "plaster": 3.0, "wood": 2.0, "paving": 2.0,
	"asphalt": 3.0, "metal": 1.0, "grass": 2.0,
	"earth": 2.5, "gravel": 2.0, "sand": 2.5, "rock": 4.0, "forest_floor": 3.0, "snow": 3.0, "mud": 2.5,
	"fallen_leaves": 2.0,
}
# Preset name -> scanned folder, where they differ.
const SCAN_FOLDER := {"grass": "lawn"}


func _init() -> void:
	DirAccess.make_dir_recursive_absolute(OUT + "/textures")
	var scanned := 0
	for name in SCAN_WIDTH_M:
		if _save_scanned(name):
			scanned += 1
	print("%d presets from scanned materials" % scanned)
	_save("concrete", _concrete(), 2.0, Color(0.74, 0.73, 0.7), 0.85)
	# Mortar is the light colour but sits below the bricks, so brick's height
	# is the inverse of its brightness.
	_save("brick", _brick(), 0.9, Color.WHITE, 0.9, true)
	_save("wood", _wood(), 1.2, Color.WHITE, 0.6)
	_save("stone", _stone(), 1.5, Color.WHITE, 0.8)
	_save("asphalt", _asphalt(), 2.0, Color(0.42, 0.42, 0.42), 0.9)
	_save("grass", _grass(), 3.0, Color.WHITE, 0.95)
	# Real glazing is dark and mirror-like from outside; it is the reflection
	# that reads as glass, not a pale tint.
	_save_plain("glass", Color(0.05, 0.07, 0.08, 0.72), 0.0, 0.0, true)
	_save_plain("metal", Color(0.55, 0.56, 0.58), 0.35, 0.9, false)
	var license := FileAccess.open(OUT + "/materials.license.json", FileAccess.WRITE)
	license.store_string(JSON.stringify({
		"source": "Generated by tools/make_materials.gd",
		"author": "Utopian Academy",
		"license": "CC0-1.0",
		"attribution": "None required",
	}, "  ") + "\n")
	license.close()
	print("materials written to ", ProjectSettings.globalize_path(OUT))
	quit()


# A textured preset: albedo from `albedo`, a normal map from its brightness,
# repeating every `tile_m` metres.
func _save(name: String, albedo: Image, tile_m: float, tint: Color, roughness: float, recessed_light := false) -> void:
	if _scanned_exists(name):
		return
	var dir := OUT + "/textures/"
	albedo.generate_mipmaps()
	albedo.save_png(dir + name + "_albedo.png")
	var height := albedo.duplicate() as Image
	height.clear_mipmaps()
	height.convert(Image.FORMAT_RF)
	if recessed_light:
		for y in height.get_height():
			for x in height.get_width():
				height.set_pixel(x, y, Color(1.0 - height.get_pixel(x, y).r, 0, 0))
	height.bump_map_to_normal_map(2.0)
	height.save_png(dir + name + "_normal.png")
	_import_settings(dir + name + "_albedo.png", false)
	_import_settings(dir + name + "_normal.png", true)

	var m := StandardMaterial3D.new()
	m.resource_name = name.capitalize()
	# Loaded from the PNGs by path, so the .tres stays small and the textures
	# go through Godot's importer (compression, mipmaps) like any asset.
	m.albedo_texture = _png(dir + name + "_albedo.png")
	m.albedo_color = tint
	m.normal_enabled = true
	m.normal_texture = _png(dir + name + "_normal.png")
	m.normal_scale = 0.6
	m.roughness = roughness
	m.uv1_triplanar = true
	m.uv1_world_triplanar = true
	m.uv1_triplanar_sharpness = 4.0
	m.uv1_scale = Vector3.ONE / tile_m
	# The Materials tab shows pattern size relative to this.
	m.set_meta("gn_tile_m", tile_m)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	ResourceSaver.save(m, "%s/%s.tres" % [OUT, name])


func _save_plain(name: String, color: Color, roughness: float, metallic: float, transparent: bool) -> void:
	if _scanned_exists(name):
		return
	var m := StandardMaterial3D.new()
	m.resource_name = name.capitalize()
	m.albedo_color = color
	m.roughness = roughness
	m.metallic = metallic
	if transparent:
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		m.cull_mode = BaseMaterial3D.CULL_DISABLED
		# Full specular: glass is a mirror at grazing angles and should pick
		# up the sky and the trees around it.
		m.metallic_specular = 1.0
		m.clearcoat_enabled = true
		m.clearcoat = 1.0
		m.clearcoat_roughness = 0.0
	ResourceSaver.save(m, "%s/%s.tres" % [OUT, name])


func _scanned_exists(name: String) -> bool:
	var folder := "%s/%s" % [SCANNED, SCAN_FOLDER.get(name, name)]
	return SCAN_WIDTH_M.has(name) and FileAccess.file_exists("%s/%s_Color.jpg" % [folder, SCAN_FOLDER.get(name, name)])


# A preset from a scanned material: colour, normal, roughness and, where the
# scan has one, ambient occlusion. Mapped triplanar in world space at the
# texture's real size.
func _save_scanned(name: String) -> bool:
	if not _scanned_exists(name):
		return false
	var base: String = SCAN_FOLDER.get(name, name)
	var stem := "%s/%s/%s" % [SCANNED, base, base]
	var colour_img := Image.load_from_file(ProjectSettings.globalize_path(stem + "_Color.jpg"))
	var aspect := float(colour_img.get_height()) / colour_img.get_width()
	var width: float = SCAN_WIDTH_M[name]
	var m := StandardMaterial3D.new()
	m.resource_name = name.capitalize()
	for map in ["Color", "NormalGL", "Roughness", "AmbientOcclusion"]:
		if FileAccess.file_exists("%s_%s.jpg" % [stem, map]):
			_import_settings("%s_%s.jpg" % [stem, map], map == "NormalGL")
	m.albedo_texture = _png(stem + "_Color.jpg")
	m.normal_enabled = true
	m.normal_texture = _png(stem + "_NormalGL.jpg")
	m.roughness = 1.0
	m.roughness_texture = _png(stem + "_Roughness.jpg")
	m.roughness_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_RED
	if FileAccess.file_exists(stem + "_AmbientOcclusion.jpg"):
		m.ao_enabled = true
		m.ao_texture = _png(stem + "_AmbientOcclusion.jpg")
		m.ao_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_RED
	if name == "metal":
		m.metallic = 1.0
	m.uv1_triplanar = true
	m.uv1_world_triplanar = true
	m.uv1_triplanar_sharpness = 4.0
	# x and z run along walls and floors, y up walls.
	m.uv1_scale = Vector3(1.0 / width, 1.0 / (width * aspect), 1.0 / width)
	m.set_meta("gn_tile_m", width)
	m.set_meta("gn_scanned", true)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	ResourceSaver.save(m, "%s/%s.tres" % [OUT, name])
	return true


# Import settings decided up front: VRAM-compressed with mipmaps, as a 3D
# texture should be. Left to itself Godot imports a PNG as a 2D image, then
# notices it is used in 3D (and as a normal map) and reimports it in the
# background, which collides with anything else importing at the time.
func _import_settings(png: String, normal_map: bool) -> void:
	var existing := FileAccess.get_file_as_string(png + ".import")
	if existing.contains("detect_3d/compress_to=0"):
		return
	var f := FileAccess.open(png + ".import", FileAccess.WRITE)
	f.store_string("\n".join([
		"[remap]", "", 'importer="texture"', 'type="CompressedTexture2D"', "",
		"[params]", "",
		"compress/mode=2",
		"compress/normal_map=%d" % (1 if normal_map else 2),
		"mipmaps/generate=true",
		"detect_3d/compress_to=0",
		""]))
	f.close()


# The PNG exists on disk but has not been imported yet, so the material gets
# a placeholder resource with the right path; Godot resolves it on import.
func _png(path: String) -> Texture2D:
	var t := PlaceholderTexture2D.new()
	t.resource_path = path
	return t


# ---------------------------------------------------------------------------
# The patterns. All tile seamlessly.
# ---------------------------------------------------------------------------
func _noise(freq: float, seed: int, kind := FastNoiseLite.TYPE_SIMPLEX_SMOOTH) -> Image:
	var n := FastNoiseLite.new()
	n.seed = seed
	n.noise_type = kind
	n.frequency = freq
	n.fractal_octaves = 5
	return n.get_seamless_image(SIZE, SIZE, false, false, 0.1, true)


func _map(src: Image, fn: Callable) -> Image:
	var out := Image.create(SIZE, SIZE, false, Image.FORMAT_RGB8)
	for y in SIZE:
		for x in SIZE:
			out.set_pixel(x, y, fn.call(x, y, src.get_pixel(x, y).r))
	return out


func _concrete() -> Image:
	var fine := _noise(0.08, 3)
	var coarse := _noise(0.006, 4)
	return _map(fine, func(x, y, v):
		var g: float = 0.82 + 0.1 * (v - 0.5) + 0.12 * (coarse.get_pixel(x, y).r - 0.5)
		return Color(g, g, g * 0.98))


# Running bond. The texture holds 4 bricks across and 8 courses up, so it
# tiles every 0.9 m wide by 0.6 m tall: a 215 mm brick plus 10 mm joint, and
# 75 mm courses.
func _brick() -> Image:
	var grain := _noise(0.09, 5)
	var mortar := Color(0.72, 0.7, 0.66)
	var rng := RandomNumberGenerator.new()
	var shades := {}
	var brick_w := SIZE / 4.0
	var course := SIZE / 8.0
	var joint := SIZE * 0.010 / 0.9
	return _map(grain, func(x, y, v):
		var row := int(y / course)
		var shift := brick_w / 2.0 if row % 2 == 1 else 0.0
		var col := int(fposmod(x + shift, SIZE) / brick_w)
		var in_x := fposmod(x + shift, brick_w)
		var in_y := fposmod(y, course)
		if in_x < joint or in_y < joint:
			return mortar * (0.95 + 0.1 * v)
		var key := row * 16 + col
		if not shades.has(key):
			rng.seed = key * 7919 + 13
			shades[key] = Color(0.55, 0.26, 0.18).lerp(Color(0.66, 0.36, 0.24), rng.randf())
		return (shades[key] as Color) * (0.88 + 0.24 * v))


# Planks 140 mm wide running along the texture, grain stretched along them.
func _wood() -> Image:
	var n := FastNoiseLite.new()
	n.seed = 6
	n.frequency = 0.02
	n.fractal_octaves = 4
	var planks := int(SIZE / (SIZE * 0.14 / 1.2))
	var out := Image.create(SIZE, SIZE, false, Image.FORMAT_RGB8)
	var plank_h := SIZE / float(planks)
	for y in SIZE:
		var plank := int(y / plank_h)
		for x in SIZE:
			# Sampled on a circle so the grain wraps seamlessly along x.
			var a := TAU * x / SIZE
			var g := n.get_noise_3d(cos(a) * 30.0, sin(a) * 30.0, y * 6.0 + plank * 400.0)
			var ring := 0.5 + 0.5 * sin(g * 14.0)
			var c := Color(0.45, 0.28, 0.16).lerp(Color(0.62, 0.42, 0.26), ring)
			if fposmod(y, plank_h) < 1.5:
				c = c * 0.55
			out.set_pixel(x, y, c * (0.92 + 0.08 * ((plank * 37) % 5) / 4.0))
	return out


func _stone() -> Image:
	var cells := _noise(0.012, 8, FastNoiseLite.TYPE_CELLULAR)
	var grain := _noise(0.1, 9)
	return _map(cells, func(x, y, v):
		var g: float = 0.5 + 0.25 * v + 0.08 * (grain.get_pixel(x, y).r - 0.5)
		return Color(g, g * 0.97, g * 0.92))


func _asphalt() -> Image:
	var fine := _noise(0.35, 10)
	var patches := _noise(0.01, 11)
	return _map(fine, func(x, y, v):
		var g: float = 0.25 + 0.12 * v + 0.05 * (patches.get_pixel(x, y).r - 0.5)
		if v > 0.85:
			g += 0.2
		return Color(g, g, g))


func _grass() -> Image:
	var fine := _noise(0.2, 12)
	var patches := _noise(0.01, 13)
	return _map(fine, func(x, y, v):
		var p: float = patches.get_pixel(x, y).r
		return Color(0.28 + 0.1 * p, 0.42 + 0.12 * v, 0.16 + 0.05 * p))
